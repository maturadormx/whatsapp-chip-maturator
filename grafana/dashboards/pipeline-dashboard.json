{
  "id": null,
  "uid": "pipeline-dashboard",
  "title": "Pipeline",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Throughput por minuto",
      "gridPos": { "x": 0, "y": 0, "w": 14, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(pipeline_started_total[1m]) * 60", "legendFormat": "started/min", "refId": "A" },
        { "expr": "rate(pipeline_completed_total[1m]) * 60", "legendFormat": "completed/min", "refId": "B" },
        { "expr": "rate(pipeline_failed_total[1m]) * 60", "legendFormat": "failed/min", "refId": "C" }
      ]
    },
    {
      "type": "stat",
      "title": "Taxa de falha",
      "gridPos": { "x": 14, "y": 0, "w": 10, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "increase(pipeline_failed_total[5m]) / clamp_min(increase(pipeline_started_total[5m]), 1)", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latência da pipeline",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(pipeline_processing_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(pipeline_processing_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Totais acumulados",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "pipeline_started_total", "legendFormat": "started total", "refId": "A" },
        { "expr": "pipeline_completed_total", "legendFormat": "completed total", "refId": "B" },
        { "expr": "pipeline_failed_total", "legendFormat": "failed total", "refId": "C" }
      ]
    }
  ]
}
