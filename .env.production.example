NODE_ENV=production
PORT=3000

APP_DOMAIN=app.example.com
GRAFANA_DOMAIN=grafana.example.com
GRAFANA_ROOT_URL=https://grafana.example.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

DATABASE_URL=mysql://chip_user:change-me@mysql:3306/whatsapp_chip_maturator
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=whatsapp_chip_maturator
MYSQL_USER=chip_user
MYSQL_PASSWORD=change-me

REDIS_URL=redis://redis:6379

JWT_SECRET=change-me
COOKIE_SECRET=change-me
SECRETS_MASTER_KEY=change-me
SESSION_SECRET=change-me

OAUTH_SERVER_URL=https://oauth.example.com
VITE_OAUTH_PORTAL_URL=https://portal.example.com
VITE_APP_ID=whatsapp-chip-maturator

TELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OBSERVATION_RUNTIME_DRIVER=mysql
OBSERVATION_QUEUE_ENABLED=true
OBSERVATION_SCHEDULER_ENABLED=true
DISTRIBUTED_RUNTIME_ENABLED=true
CLUSTER_NODE_ID=prod-node-1
CLUSTER_NODE_ROLE=worker

BACKUP_ROOT=./backups
BACKUP_RETENTION_DAYS=14
ROLLING_UPDATE_ENABLED=true
PUBLIC_BASE_URL=https://app.example.com
