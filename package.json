{
  "name": "whatsapp-chip-maturator",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/operational/dev.mjs",
    "build": "node scripts/operational/build.mjs",
    "start": "node scripts/operational/start.mjs",
    "check": "tsc --noEmit",
    "validate:architecture": "tsx scripts/maintenance/validate-architecture-boundaries.ts",
    "validate:fitness": "tsx scripts/maintenance/validate-architecture-fitness.ts",
    "validate:operational": "tsx scripts/maintenance/validate-operational-calculation.ts",
    "validate:sandbox": "tsx scripts/maintenance/validate-behavior-sandbox.ts",
    "validate:contracts": "pnpm validate:architecture && pnpm validate:fitness && pnpm check",
    "replay:dataset": "tsx scripts/maintenance/run-behavior-replay.ts",
    "generate:synthetic-dataset": "tsx scripts/maintenance/generate-synthetic-behavior-dataset.ts",
    "format": "prettier --write .",
    "test": "node scripts/operational/test.mjs",
    "test:integration:observation": "vitest run server/infrastructure/persistence/mysql/*.integration.test.ts",
    "db:push": "drizzle-kit --config drizzle.config.ts generate && drizzle-kit --config drizzle.config.ts migrate",
    "local:db:up": "docker compose -f docker-compose.local.yml up -d",
    "local:db:down": "docker compose -f docker-compose.local.yml down",
    "local:db:logs": "docker compose -f docker-compose.local.yml logs -f mysql"
  },
