PORT=3000

# Banco de dados
DATABASE_URL=mysql://usuario:senha@host:3306/whatsapp_chip_maturator
OBSERVATION_RUNTIME_DRIVER=memory
OBSERVATION_SCHEDULER_ENABLED=false
OBSERVATION_SCHEDULER_INTERVAL_MS=300000
OBSERVATION_SCHEDULER_BATCH_SIZE=25
OBSERVATION_QUEUE_ENABLED=false
OBSERVATION_QUEUE_NAME=observation-runtime
OBSERVATION_QUEUE_ATTEMPTS=5
OBSERVATION_QUEUE_BACKOFF_MS=2000
REDIS_URL=redis://localhost:6379
TELEMETRY_ENABLED=false

# OAuth backend
OAUTH_SERVER_URL=https://seu-servidor-oauth.com
JWT_SECRET=troque-esta-chave-por-uma-segura
OWNER_OPEN_ID=

# OAuth frontend
VITE_OAUTH_PORTAL_URL=https://seu-portal-oauth.com
VITE_APP_ID=seu-app-id

# Opcionais do ambiente Manus/Forge
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
