NODE_ENV=production
PORT=3000

# Banco de dados
DATABASE_URL=mysql://USUARIO_DB:SENHA_DB@HOST_DB:3306/whatsapp_chip_maturator
MYSQL_ROOT_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
MYSQL_DATABASE=whatsapp_chip_maturator
MYSQL_USER=chip_user
MYSQL_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE

# OAuth backend
OAUTH_SERVER_URL=https://oauth.seu-dominio.com
JWT_SECRET=TROQUE_POR_UMA_CHAVE_FORTE_E_GRANDE
OWNER_OPEN_ID=

# OAuth frontend
VITE_OAUTH_PORTAL_URL=https://portal.seu-dominio.com
VITE_APP_ID=SEU_APP_ID

# Opcionais do ambiente Forge/Manus
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Runtime operacional
REDIS_URL=redis://redis:6379
OBSERVATION_RUNTIME_DRIVER=mysql
OBSERVATION_QUEUE_ENABLED=true
OBSERVATION_SCHEDULER_ENABLED=true
OBSERVATION_SCHEDULER_INTERVAL_MS=10000
OBSERVATION_SCHEDULER_BATCH_SIZE=25
SCHEDULED_TASK_RUNNER_ENABLED=true
SCHEDULED_TASK_RUNNER_INTERVAL_MS=10000
TELEMETRY_ENABLED=true
RUNTIME_DEBUG_LOGS=false
LOCAL_AUTH_ENABLED=false
